# Copy to .env and fill in. The .env may live at the repo root (here) or in
# backend/ — settings.py searches from backend/ upward.
#
# Generate a SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

# ---------------------------------------------------------------------------
# Local development (default) — SQLite, no database setup required
# ---------------------------------------------------------------------------
DJANGO_ENV=local
SECRET_KEY=replace-me-with-a-generated-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Deposit taken up front for a mobile money booking, in Guinean francs.
# Cash-on-arrival bookings pay nothing now. Optional; defaults to 50000.
# RESERVATION_DEPOSIT_AMOUNT=50000

# ---------------------------------------------------------------------------
# Production — PostgreSQL. Set DJANGO_ENV=production and all five DB_* vars.
# DB_HOST defaults to localhost and DB_PORT to 5432 if omitted.
# ---------------------------------------------------------------------------
# DJANGO_ENV=production
# SECRET_KEY=a-different-generated-key-kept-out-of-git
# DEBUG=False
# ALLOWED_HOSTS=api.sylibooking.com
# Browser origins allowed to call the API. Only needed for Flutter web builds;
# unset means none are allowed. Local development allows any origin already.
# CORS_ALLOWED_ORIGINS=https://app.sylibooking.com
# DB_NAME=sylibooking
# DB_USER=sylibooking
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432