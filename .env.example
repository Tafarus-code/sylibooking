# Copy to .env and fill in. Nothing here is a real credential.
#
# Only SECRET_KEY has no default — every other setting runs locally without
# being set, which is deliberate: a checkout should start with one command.

# --- Always ---------------------------------------------------------------
SECRET_KEY=generate-me-with-django-secret-key

# local (SQLite, permissive CORS, plain logs) or production.
DJANGO_ENV=local
DEBUG=True

# --- Production only ------------------------------------------------------
# ALLOWED_HOSTS=api.sylibooking.gn
# CSRF_TRUSTED_ORIGINS=https://api.sylibooking.gn
# CORS_ALLOWED_ORIGINS=https://sylibooking.gn

# DB_NAME=sylibooking
# DB_USER=sylibooking
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432

# CELERY_BROKER_URL=redis://redis:6379/0

# Photos must not live on the container's disk: a redeploy replaces the
# container and takes every uploaded photo with it.
#
# Cloudflare R2 — S3-compatible, and no egress charge, which is the whole
# argument when the heaviest thing served is a venue's photographs.
# USE_S3_MEDIA=True
# AWS_STORAGE_BUCKET_NAME=sylibooking-media
# AWS_S3_REGION_NAME=auto                       # R2 wants 'auto'
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=                            # R2 API token, S3-compatible
# AWS_SECRET_ACCESS_KEY=
#
# The public hostname attached to the bucket. R2's API endpoint is not
# publicly readable, so without this every photo 401s while the config looks
# perfect. Either the r2.dev subdomain or a custom domain.
# MEDIA_CUSTOM_DOMAIN=media.sylibooking.gn

# Errors go to the log when this is empty, which is a real destination.
# SENTRY_DSN=

# Off during tests automatically; set False to disable deliberately.
# THROTTLING_ENABLED=True
